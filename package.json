		"@tailwindcss/vite": "^4.1.4",
		"svelte-check": "^4.0.0",
		"typescript": "^5.0.0",
		"vite": "^6.2.6"
	},
	"dependencies": {
		"@lucide/svelte": "^0.503.0",
		"cva": "npm:class-variance-authority@^0.7.1",
		"svelte": "^5.0.0",
		"tailwind-merge": "^3.2.0",
		"tailwindcss": "^4.1.4"
	},
	"peerDependencies": {
