{
	"name": "neobrutalism-components-svelte",
	"private": false,
	"version": "0.1.4",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.0.0",
		"@sveltejs/package": "^2.3.11",
		"@tailwindcss/vite": "^4.1.4",
		"vite": "^6.2.6"
	},
	"dependencies": {
		"svelte": "^5.0.0",
		"cva": "npm:class-variance-authority@^0.7.1",
		"tailwindcss": "^4.1.4",
		"tailwind-merge": "^3.2.0"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"files": [
		"dist"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./Alert.svelte": {
			"types": "./dist/components/alert/Alert.svelte.d.ts",
			"svelte": "./dist/components/alert/Alert.svelte"
		},
		"./AlertDescription.svelte": {
			"types": "./dist/components/alert/AlertDescription.svelte.d.ts",
			"svelte": "./dist/components/alert/AlertDescription.svelte"
		},
		"./AlertTitle.svelte": {
			"types": "./dist/components/alert/AlertTitle.svelte.d.ts",
			"svelte": "./dist/components/alert/AlertTitle.svelte"
		},
		"./Badge.svelte": {
			"types": "./dist/components/badge/Badge.svelte.d.ts",
			"svelte": "./dist/components/badge/Badge.svelte"
		},
		"./Button.svelte": {
			"types": "./dist/components/button/Button.svelte.d.ts",
			"svelte": "./dist/components/button/Button.svelte"
		},
		"./package.json": "./package.json",
		"./style.css": "./dist/style.css"
	}
}